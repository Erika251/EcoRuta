<?xml version="1.0" encoding="utf-8"?>
<!-- Seguridad: la app solo se conecta por HTTPS (conexión cifrada). Nada viaja en texto plano. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
